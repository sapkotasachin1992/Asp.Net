@model Person

@{
    ViewData["TitlePhrase"] = "update Employee";
    string[] genders = { "male", "female", "others" };
}

<h2>Update Employee</h2>
<hr>

<form asp-controller="Employee" asp-action="Update" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input type="text" class="form-control" asp-for="FirstName">
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SurName" class="form-label"></label>
        <input type="text" class="form-control" asp-for="SurName">
        <span asp-validation-for="SurName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea class="form-control" asp-for="Address"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Gender" class="form-label"></label>
        @foreach (string gender in genders)
        {
            <input id="@gender" type="radio" asp-for="Gender" value="@gender.ToUpper()[0]" />
            

            
        }
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Salary" class="form-label"></label>
        <input type="number" class="form-control" asp-for="Salary">
        <span asp-validation-for="Salary" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update Employee</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}